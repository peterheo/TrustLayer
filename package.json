{
  "name": "trustlayer",
  "version": "0.1.0",
  "private": true,
  "description": "Agent-to-agent verification gateway. Independently verifies factual output from another agent, on SharedOS.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx scripts/smoke.ts",
    "demo:injection": "tsx scripts/demo-injection.ts",
    "eval": "tsx evals/run.ts",
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "serve:check": "tsx scripts/serve-check.ts",
    "room:respond": "tsx scripts/sharednet-respond.ts",
    "room:serve": "tsx scripts/sharednet-room.ts",
    "node:id": "tsx scripts/sharednet-node.ts"
  },
  "dependencies": {
    "@aicoo/sharedos": "0.1.0-alpha.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@aicoo/sharedos-testkit": "0.1.0-alpha.5",
    "@types/node": "^22.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
