# Names only. Never commit real values.

# Model provider used by the verifier driver.
# MODEL_PROVIDER=anthropic | scripted
MODEL_PROVIDER=
MODEL_NAME=
MODEL_API_KEY=

# Token prices for the benchmark's cost column, in USD per million tokens.
# Unset means `pnpm eval` reports cost as n/a rather than guessing a price.
MODEL_INPUT_USD_PER_MTOK=
MODEL_OUTPUT_USD_PER_MTOK=

# Budgets for the benchmark's web-agent baseline. Defaults match TrustLayer's
# own one-claim budget; actual usage is measured and reported either way.
EVAL_WEB_BASELINE_MAX_TOOL_CALLS=
EVAL_WEB_BASELINE_MAX_MODEL_CALLS=

# Search backend behind research.search.
# SEARCH_PROVIDER=brave | tavily | none
SEARCH_PROVIDER=
SEARCH_API_KEY=

# Organizer-supplied SharedOS Cloud identity.
# Request these in the hackathon Discord #arena-support (see arena/DEPLOYMENT.md).
# SHAREDOS_TENANT_ID becomes the AccessContext namespaceId and every grant's
# namespaceId; SHAREDOS_OWNER_ADDRESS is "service:<id>", "agent:<id>",
# "human:<userId>" or "group:<conversationId>".
SHAREDOS_TENANT_ID=
SHAREDOS_OWNER_ADDRESS=

# Still unknown until the organizers publish them: see NOTES.md section 5.
SHAREDOS_BASE_URL=
SHAREDOS_TOKEN=
ARENA_SERVICE_ID=
ARENA_PRICE_CREDITS=

# SharedNet (the Arena network): https://www.sharednet.ai/api/docs
# SHAREDNET_API_KEY is the account key (snk_…) from the developers console; the
# service mints its own instance token (sni_…) from it and prints the node id.
# SHAREDNET_ROOM_ID is the room to sit in (rom_…).
SHAREDNET_API_KEY=
SHAREDNET_INSTANCE_TOKEN=
SHAREDNET_ROOM_ID=
SHAREDNET_BASE_URL=

# The HTTP service.
PORT=8080
HOST=0.0.0.0
# Bearer token callers must present. Unset means unauthenticated — fine for a
# local demo, never for a deployment.
TRUSTLAYER_API_TOKEN=

NODE_ENV=
LOG_LEVEL=
